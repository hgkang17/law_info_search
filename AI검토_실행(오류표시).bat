@echo off
rem 실험 갈래용 실행 파일.
rem 기존 "국가법령정보 통합검색.bat"은 pythonw로 띄워서 콘솔이 없다.
rem 그러면 오류가 나도 창만 안 뜨고 이유를 알 수 없으므로,
rem 실험 중에는 콘솔을 남기는 이 파일로 실행한다.
chcp 65001 > nul
cd /d "%~dp0"
echo 국가법령정보 통합검색 (AI 검토 실험) 을 시작합니다...
echo.
python "%~dp0main.py"
echo.
echo ============================================================
echo  프로그램이 끝났습니다.
echo  오류가 있었다면 위에 내용이 남아 있습니다.
echo ============================================================
pause
